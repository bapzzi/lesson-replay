{
  "name": "lesson-replay",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.0.0",
  "publisher": "bapzzi",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Education"],
  "keywords": ["replay", "history", "retrospective", "bootcamp", "study-log", "복기", "타임라인", "TIL", "부트캠프", "학습기록"],
  "galleryBanner": { "color": "#1f1f1f", "theme": "dark" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "lessonReplay.openStory", "title": "%command.openStory%" },
      { "command": "lessonReplay.openStoryForDate", "title": "%command.openStoryForDate%" },
      { "command": "lessonReplay.toggleRecord", "title": "%command.toggleRecord%" },
      { "command": "lessonReplay.openNotes", "title": "%command.openNotes%", "icon": "$(edit)" },
      { "command": "lessonReplay.editTemplate", "title": "%command.editTemplate%", "icon": "$(layout)" },
      { "command": "lessonReplay.useTimetable", "title": "%command.useTimetable%" },
      { "command": "lessonReplay.useSessions", "title": "%command.useSessions%" },
      { "command": "lessonReplay.exportDay", "title": "%command.exportDay%" },
      { "command": "lessonReplay.initRepo", "title": "%command.initRepo%" },
      { "command": "lessonReplay.setArchiveDir", "title": "%command.setArchiveDir%" },
      { "command": "lessonReplay.refreshDays", "title": "%command.refreshDays%", "icon": "$(refresh)" }
    ],
    "views": {
      "explorer": [
        { "id": "lessonReplay.days", "name": "%view.days%", "icon": "$(history)" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lessonReplay.days",
        "contents": "%welcome.noFolder%",
        "when": "lessonReplay.state == 'noFolder'"
      },
      {
        "view": "lessonReplay.days",
        "contents": "%welcome.notRepo%",
        "when": "lessonReplay.state == 'notRepo'"
      },
      {
        "view": "lessonReplay.days",
        "contents": "%welcome.noCommits%",
        "when": "lessonReplay.state == 'noCommits'"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "lessonReplay.openNotes", "when": "view == lessonReplay.days", "group": "navigation@1" },
        { "command": "lessonReplay.refreshDays", "when": "view == lessonReplay.days", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "lessonReplay.editTemplate", "when": "view == lessonReplay.days && viewItem == todayNote", "group": "inline" }
      ]
    },
    "walkthroughs": [
      {
        "id": "lessonReplay.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "mode",
            "title": "%walkthrough.mode.title%",
            "description": "%walkthrough.mode.description%",
            "media": { "markdown": "media/step-mode.md" },
            "completionEvents": ["onCommand:lessonReplay.useTimetable", "onCommand:lessonReplay.useSessions"]
          },
          {
            "id": "record",
            "title": "%walkthrough.record.title%",
            "description": "%walkthrough.record.description%",
            "media": { "markdown": "media/step-record.md" },
            "completionEvents": ["onCommand:lessonReplay.toggleRecord"]
          },
          {
            "id": "notes",
            "title": "%walkthrough.notes.title%",
            "description": "%walkthrough.notes.description%",
            "media": { "markdown": "media/step-notes.md" },
            "completionEvents": ["onCommand:lessonReplay.openNotes"]
          },
          {
            "id": "story",
            "title": "%walkthrough.story.title%",
            "description": "%walkthrough.story.description%",
            "media": { "image": "images/replay-view.png", "altText": "%walkthrough.story.altText%" },
            "completionEvents": ["onCommand:lessonReplay.openStory"]
          },
          {
            "id": "export",
            "title": "%walkthrough.export.title%",
            "description": "%walkthrough.export.description%",
            "media": { "markdown": "media/step-export.md" },
            "completionEvents": ["onCommand:lessonReplay.exportDay"]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%config.record.title%",
        "properties": {
          "lessonReplay.autoRecord": {
            "order": 0, "type": "boolean", "default": false, "scope": "resource",
            "description": "%config.autoRecord.description%"
          },
          "lessonReplay.commitDelaySeconds": {
            "order": 1, "type": "number", "default": 20,
            "description": "%config.commitDelaySeconds.description%"
          },
          "lessonReplay.watchFileChanges": {
            "order": 2, "type": "boolean", "default": true,
            "description": "%config.watchFileChanges.description%"
          },
          "lessonReplay.watchRepoRoot": {
            "order": 3, "type": "boolean", "default": true,
            "description": "%config.watchRepoRoot.description%"
          }
        }
      },
      {
        "title": "%config.timetable.title%",
        "properties": {
          "lessonReplay.blocks": {
            "order": 0, "type": "array", "items": { "type": "string" },
            "default": ["09:10-10:20", "10:30-11:30", "13:00-13:45", "14:00-14:45", "15:15-16:00", "16:15-16:45", "16:45-17:50"],
            "description": "%config.blocks.description%"
          },
          "lessonReplay.sessionGapMinutes": {
            "order": 1, "type": "number", "default": 30, "minimum": 5,
            "description": "%config.sessionGapMinutes.description%"
          },
          "lessonReplay.holidays": {
            "order": 2, "type": "array", "items": { "type": "string" },
            "default": [],
            "description": "%config.holidays.description%"
          },
          "lessonReplay.notesDir": {
            "order": 3, "type": "string", "default": "필기",
            "description": "%config.notesDir.description%"
          },
          "lessonReplay.archiveDir": {
            "order": 4, "type": "string", "default": "",
            "description": "%config.archiveDir.description%"
          },
          "lessonReplay.paragraphGapMinutes": {
            "order": 5, "type": "number", "default": 3,
            "description": "%config.paragraphGapMinutes.description%"
          }
        }
      },
      {
        "title": "%config.review.title%",
        "properties": {
          "lessonReplay.noiseThreshold": {
            "order": 0, "type": "number", "default": 10,
            "description": "%config.noiseThreshold.description%"
          },
          "lessonReplay.excludePrefixes": {
            "order": 1, "type": "array", "items": { "type": "string" },
            "default": ["필기/", "복기/"],
            "description": "%config.excludePrefixes.description%"
          },
          "lessonReplay.includeTilPrompt": {
            "order": 2, "type": "boolean", "default": false,
            "description": "%config.includeTilPrompt.description%"
          },
          "lessonReplay.tilPrompt": {
            "order": 3, "type": "string",
            "default": "아래는 오늘 라이브 코딩 수업에서 내 편집기에 남은 자동 기록이다: 파트별 '배운 것' 메모, 수업 중 필기(있는 경우), 파일별 코드 변경 이력(diff). 이걸 바탕으로 부트캠프 제출용 TIL 초안을 작성해줘.\n- 흐름 먼저: 시간순 나열이 아니라 '오늘 무엇을 만들려고 어떤 순서로 갔는가'를 한 줄로 세우고, 그 흐름 위에 개념을 얹는다\n- 전부 나열 금지: 핵심 개념 1~2개만 골라 깊게. 나머지는 한 줄 훑기로 끝낸다\n- 코드는 달라진 부분만 짧게 인용하고 왜 그렇게 쓰는지 한 줄씩. 파일 전문 붙여넣기 금지\n- 지웠다 다시 만든 흔적(♻️)·고친 흔적은 트러블슈팅으로: 문제/원인/해결/재발 방지\n- 필기가 있으면 그 표현을 살려 '나의 언어'로. 오탈자만 다듬고, AI 티 나는 문장·억지 마무리 금지\n- 쓸 내용이 없는 항목은 뺀다. 칸을 채우려고 만든 문단 금지",
            "editPresentation": "multilineText",
            "description": "%config.tilPrompt.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "test": "node --test test/*.test.js"
  },
  "repository": { "type": "git", "url": "https://github.com/bapzzi/lesson-replay" }
}
